{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "packageRules": [
    {
      "description": [
        "Auto-merge all updates from my own packages"
      ],
      "matchPackageNames": [
        "ghcr.io/ronaldphilipsen/**",
        "ronaldphilipsen/**"
      ],
      "automerge": true
    }
  ]
}
